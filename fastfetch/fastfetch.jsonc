{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    {
      "type": "datetime",
      "key": "Date",
      "format": "{11}-{4}-{1}"
    },
    {
      "type": "datetime",
      "key": "Current time",
      "format": "{13}:{18}:{20}"
    },
    "packages",
    "de",
    "wm",
    "wmtheme",
    "terminal",
    "memory",
    "disk",
    "locale",
    "break",
    "colors",
  ],
  "logo":"~/.config/fastfetch/cat",
}
